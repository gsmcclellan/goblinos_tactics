public interface IStatModifier
{
    int AccuracyDelta { get; }
    int EvasionDelta { get; }
    int ProtectionDelta { get; }
    // etc
}

public sealed class DerivedStats
{
    public int Accuracy { get; }
    public int Evasion { get; }
    public int CritChance { get; }
    public int Protection { get; }
    public int Speed { get; }
    public int MaxHealth { get; }

    public DerivedStats(
        StatBlock baseStats,
        IEnumerable<IStatModifier> modifiers,
        StatCaps caps)
    {
        Accuracy = Clamp(
            baseStats.Accuracy + modifiers.Sum(m => m.AccuracyDelta),
            caps.MinAccuracy,
            caps.MaxAccuracy
        );

        Evasion = Clamp(
            baseStats.Evasion + modifiers.Sum(m => m.EvasionDelta),
            caps.MinEvasion,
            caps.MaxEvasion
        );

        Protection = Clamp(
            baseStats.Protection + modifiers.Sum(m => m.ProtectionDelta),
            0,
            caps.MaxProtection
        );

        // etc...
    }
}

