DD - philosophy - cap stats to prevent god units. Keep things deadly.
public sealed class StatCaps
{
    public int MaxAccuracy { get; init; } = 120;
    public int MinAccuracy { get; init; } = 0;

    public int MaxEvasion { get; init; } = 75;
    public int MinEvasion { get; init; } = 0;

    public int MaxCritChance { get; init; } = 25;

    public int MaxProtection { get; init; } = 80;

    public int MaxSpeed { get; init; } = 20;
}

